#!/usr/bin/env sh
# Testing kit pre-push gate (Vite + Supabase).
# Non-blocking: runs E2E only if dev server + local Supabase are up.
# If either is missing, warns and exits 0 (CI is the authoritative E2E gate).

DEV_URL="http://127.0.0.1:8080"
SUPA_URL="http://127.0.0.1:54321"

dev_up=0
supa_up=0

if curl -fsS -o /dev/null --max-time 2 "$DEV_URL" 2>/dev/null; then
  dev_up=1
fi
if curl -fsS -o /dev/null --max-time 2 "$SUPA_URL/auth/v1/health" 2>/dev/null || \
   curl -fsS -o /dev/null --max-time 2 "$SUPA_URL" 2>/dev/null; then
  supa_up=1
fi

if [ "$dev_up" = "1" ] && [ "$supa_up" = "1" ]; then
  echo "[pre-push] dev server + Supabase local detected — running E2E..."
  if npm run test:e2e; then
    echo "[pre-push] E2E green, push authorized."
  else
    echo "[pre-push] WARN: E2E failed but push NOT blocked (reactive gate)."
    echo "[pre-push]       Investigate locally with: npm run test:e2e"
  fi
else
  echo "[pre-push] WARN: local environment not available, skipping E2E:"
  [ "$dev_up" = "0" ]  && echo "[pre-push]   - dev server at $DEV_URL is not responding (start with: npm run dev)"
  [ "$supa_up" = "0" ] && echo "[pre-push]   - Supabase local at $SUPA_URL is not responding (start with: supabase start)"
  echo "[pre-push]   E2E gate skipped on this machine — CI must cover it."
fi

exit 0
